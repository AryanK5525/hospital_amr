<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="hospital_ward">

    <!-- Physics -->
    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <!-- Lighting -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.88 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.3 0.1 -0.9</direction>
    </light>
    <light type="point" name="corridor_light_1">
      <pose>-4 0 2.4 0 0 0</pose>
      <diffuse>0.8 0.8 0.75 1</diffuse>
      <intensity>0.5</intensity>
      <attenuation><range>10</range><constant>0.5</constant><linear>0.1</linear><quadratic>0.01</quadratic></attenuation>
    </light>
    <light type="point" name="corridor_light_2">
      <pose>3 0 2.4 0 0 0</pose>
      <diffuse>0.8 0.8 0.75 1</diffuse>
      <intensity>0.5</intensity>
      <attenuation><range>10</range><constant>0.5</constant><linear>0.1</linear><quadratic>0.01</quadratic></attenuation>
    </light>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <scene>
      <ambient>0.6 0.6 0.58 1</ambient>
      <background>0.7 0.75 0.8 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- ========== FLOOR ========== -->
    <!-- Hospital: x=[-7,7], y=[-5,5], centered at origin -->
    <model name="hospital_floor">
      <static>true</static>
      <pose>0.0 0.0 -0.005 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>16.0 12.0 0.01</size></box></geometry>
          <surface><friction><ode><mu>100</mu><mu2>50</mu2></ode></friction></surface>
        </collision>
        <visual name="vis"><geometry><box><size>16.0 12.0 0.01</size></box></geometry>
          <material><ambient>0.92 0.92 0.90 1</ambient><diffuse>0.92 0.92 0.90 1</diffuse></material>
        </visual>
      </link>
    </model>

